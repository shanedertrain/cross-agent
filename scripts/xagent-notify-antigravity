#!/usr/bin/env python3
"""Desktop notification wake handler for Antigravity xagent sessions.

Reads an xagent.wake.v1 JSON object from stdin (counts and agent id only; never
peer text) and shows a desktop notification via notify-send when available.
"""

import json
import shutil
import subprocess
import sys


def main() -> int:
    raw = sys.stdin.read().strip()
    if not raw:
        return 0
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return 0
    text = str(payload.get("text") or "").strip()
    if not text:
        return 0
    notify = shutil.which("notify-send")
    if notify:
        subprocess.run(
            [notify, "-a", "xagent", "xagent (Antigravity)", text],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
