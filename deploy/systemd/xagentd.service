# systemd --user unit. Install: cp to ~/.config/systemd/user/ (scripts/install.sh does it), then
#   systemctl --user daemon-reload && systemctl --user enable --now xagentd
# For a server that should run without a login session: loginctl enable-linger $USER
[Unit]
Description=xagent cross-agent messaging daemon
After=network-online.target nats-server.service

[Service]
ExecStart=%h/.local/bin/xagent daemon
Restart=always
RestartSec=2
# The daemon reconnects to NATS on its own; the restart covers crashes only.

[Install]
WantedBy=default.target
