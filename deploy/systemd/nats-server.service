# systemd --user unit, a template: scripts/setup-nats.sh installs it in ~/.config/systemd/user/
# with ExecStart naming the nats-server binary and config it set up. Then
#   systemctl --user daemon-reload && systemctl --user enable --now nats-server
# Only where systemd is actually PID 1 (not default WSL); otherwise use scripts/run-nats.sh.
[Unit]
Description=NATS server with JetStream for xagent
After=network-online.target

[Service]
ExecStart=%h/.local/bin/nats-server -c %h/.config/xagent/nats-server.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=default.target
